{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pruna-studio",
  "main": "src/worker.js",
  "compatibility_date": "2025-05-05",
  "assets": {
    // Static frontend. Assets are served first; requests with no matching
    // asset (e.g. /api/*) fall through to the Worker in src/worker.js.
    "directory": "./public"
  },
  // Cloudflare Workers AI. Runs on Cloudflare's own GPUs and is billed to this
  // account, so it needs no API key of its own — unlike the Pruna path.
  // `remote: true` because Workers AI has no local emulation: without it a
  // plain `wrangler dev` fails every AI call with "Binding AI needs to be run
  // remotely". Production is unaffected — the binding is remote there anyway.
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "observability": {
    "enabled": true
  }
  // Secrets are NOT stored here. They are set with `wrangler secret put`:
  //   PRUNA_API_KEY     (required) — your Pruna API key
  //   APP_PASSWORD      (optional) — shared password gate for the UI
  //   DO_INFERENCE_KEY  (optional) — DigitalOcean Gradient model access key,
  //                     needed only for the DigitalOcean models
}
