{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pruna-studio",
  "main": "src/worker.js",
  "compatibility_date": "2025-05-05",
  "assets": {
    // Static frontend. Assets are served first; requests with no matching
    // asset (e.g. /api/*) fall through to the Worker in src/worker.js.
    "directory": "./public"
  },
  // Cloudflare Workers AI. Runs on Cloudflare's own GPUs and is billed to this
  // account, so it needs no API key of its own — unlike the Pruna path.
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  }
  // Secrets are NOT stored here. They are set with `wrangler secret put`:
  //   PRUNA_API_KEY  (required) — your Pruna API key
  //   APP_PASSWORD   (optional) — shared password gate for the UI
}
